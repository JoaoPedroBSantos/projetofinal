# Copie para .env e ajuste o que precisar:  cp .env.example .env
# Se o .env não existir, o compose.yaml usa os mesmos valores como padrão.

# Porta do site (nginx) no host
WEB_PORT=8080
# Porta da API no host (é a que o proxy do vite usa em dev: frontend/vite.config.js)
API_PORT=8081

# Catálogo de demonstração (produtos/adicionais de exemplo). Deixe "false"
# para começar com o banco vazio e cadastrar tudo pelo painel. Com "true",
# as fotos demo são enviadas ao SeaweedFS na primeira subida.
SEED_DEMO_DATA=false

# PostgreSQL
POSTGRES_USER=delicias
POSTGRES_PASSWORD=delicias_dev_pwd
POSTGRES_DB=delicias
POSTGRES_PORT=5432

# SeaweedFS (API S3). As chaves precisam ser IGUAIS às de infra/seaweedfs/s3.json
S3_ACCESS_KEY=delicias
S3_SECRET_KEY=delicias_dev_secret_key
S3_BUCKET=produtos
S3_PORT=8333
FILER_PORT=8888
MASTER_PORT=9333
VOLUME_PORT=8085

# Administrador único do painel (/admin). Troque antes de publicar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# Assina o cookie de sessão: use uma string longa e aleatória em produção.
SECRET_KEY=delicias_dev_secret_change_me
# Deixe "true" só quando o site estiver em HTTPS.
COOKIE_SECURE=false
